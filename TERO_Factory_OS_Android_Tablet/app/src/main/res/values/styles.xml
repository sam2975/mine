    <color name="tero_white">#FFFFFF</color>
    <style name="Theme.TERO" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#1E8391</item>
